# ═══════════════════════════════════════════════════════
# .env — Variables de entorno locales para LatinPyme
# ═══════════════════════════════════════════════════════
# ⚠️  Este archivo NO se sube a GitHub (.gitignore lo excluye)
# ⚠️  Copia este archivo como .env y rellena los valores reales

# ── Supabase (conexion via HTTPS - REST API) ──
# Obtener en: supabase.com/dashboard/project/TU_PROYECTO/connect
SUPABASE_URL=https://TU_PROYECTO_ID.supabase.co
SUPABASE_SECRET_KEY=sb_secret_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ── WhatsApp Cloud API (Meta) ──
META_WA_TOKEN=tu_token_aqui
META_WA_PHONE_NUMBER_ID=tu_phone_number_id
META_WA_BUSINESS_ACCOUNT_ID=tu_business_account_id
META_WA_WEBHOOK_VERIFY_TOKEN=latinpyme_secret_token
META_WA_TEMPLATE_NAME=plantilla_curso_latinpyme

# ── OpenAI (opcional) ──
OPENAI_API_KEY=

# ── Flask ──
SECRET_KEY=cambia_esto_por_una_clave_aleatoria_larga
